# Server
PORT=4003
NODE_ENV=development

# CORS — comma-separate multiple origins
ALLOWED_ORIGINS=https://example.com

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# Database
DATABASE_CLIENT=mysql2
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=graphql_mysql
DATABASE_USER=
DATABASE_PASSWORD=

# MySQL root password (used by docker-compose only)
MYSQL_ROOT_PASSWORD=

# Redis — required in production for GraphQL subscriptions
# REDIS_URL=redis://localhost:6379

# Kafka — optional event backbone for comment.created; when unset, mutations
# publish straight onto the Redis/in-memory PubSub above instead.
# Start a local broker with: docker compose --profile kafka up -d kafka
# Use localhost:9092 when running the app with `npm run dev` on the host,
# or kafka:19092 when the app itself also runs inside docker compose.
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=graphql-node
# KAFKA_CONSUMER_GROUP=graphql-node-subscriptions

# Logging
LOG_LEVEL=info
